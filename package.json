{
  "name": "mago-newspaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "verify:orcarouter": "node --env-file=.env scripts/verify-orcarouter.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "publish:qiita": "node --env-file=.env scripts/publish-qiita.mjs",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "pause:aws": "bash scripts/pause-aws.sh",
    "resume:aws": "bash scripts/resume-aws.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.2.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.8",
    "vite": "^6.4.0"
  }
}
